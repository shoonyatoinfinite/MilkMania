# Milk Mania Environment Configuration Template

# Server Port
PORT=5000

# PostgreSQL Connection String (Used when USE_MOCK_DB=false)
# Replace user, password, localhost, 5432, and dbname with your credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/milkmania?schema=public"

# Secret key for JWT session tokens (Change this in production)
JWT_SECRET="milkmania_super_secure_liquid_fluid_key_2026"

# Toggle Mock Database mode. 
# - Set to true: Reads/writes from backend/data/*.json (Ready out-of-the-box, no DB required)
# - Set to false: Connects to PostgreSQL using Prisma (Run 'npm run prisma:migrate' first)
USE_MOCK_DB=true

# Initial Admin Seeding Credentials (REQUIRED when seeding database)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_MASTER_PASSWORD=
